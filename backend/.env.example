# Application
NODE_ENV=development
PORT=3000
APP_NAME=vastu-backend
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vastu_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vastu_db?schema=public

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_must_be_changed_in_production_32chars_min
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=14d

# Storage (local or s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=

# AI Services
# VISION_PROVIDER: 'existing' (uses AI_VISION_PROVIDER), 'local' (self-hosted model), or 'mock'/'gemini'/'openai'
VISION_PROVIDER=existing
AI_VISION_PROVIDER=mock
AI_LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local / Self-Hosted Vision Model Settings
LOCAL_VISION_SERVICE_URL=http://localhost:8000
LOCAL_VISION_MODEL=yolov8s
LOCAL_VISION_MODEL_PATH=
LOCAL_VISION_DEVICE=auto
LOCAL_VISION_CONFIDENCE_THRESHOLD=0.50
LOCAL_VISION_IMAGE_SIZE=640
LOCAL_VISION_TIMEOUT_MS=10000

# Vision Fallback Engine (Optional)
VISION_FALLBACK_ENABLED=false
VISION_FALLBACK_PROVIDER=existing

# Throttling / Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
